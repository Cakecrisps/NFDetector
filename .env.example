# Generate a private .env; do not use this placeholder as a real password.
POSTGRES_PASSWORD=replace_with_random_hex
NF_BIND=0.0.0.0
NF_PORT=443
NF_TLS_HOST=localhost
# Merge continuing detector activity into one incident; pause in capture seconds.
NF_INCIDENT_GAP_SECONDS=300
# Required for remote web admin: exact HTTPS origin, without trailing slash.
# NF_PUBLIC_URL=https://detector.example.com
# Optional separate address reachable from agent hosts (e.g. when the panel uses localhost).
# NF_AGENT_URL=https://192.168.122.1

# Existing server certificate: use with -f compose.yaml -f compose.tls.yaml.
# NF_TLS_CERT=/etc/letsencrypt/live/detector.example.com/fullchain.pem
# NF_TLS_KEY=/etc/letsencrypt/live/detector.example.com/privkey.pem
